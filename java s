// Utiliser Firebase Realtime Database ou Firestore
function initChat(userId, matchId) {
  const chatRef = firebase.database().ref(`chats/${getChatId(userId, matchId)}`);
  
  chatRef.on('child_added', (snapshot) => {
    displayMessage(snapshot.val());
  });
  
  document.getElementById('send-btn').onclick = () => {
    const message = document.getElementById('message-input').value;
    chatRef.push({
      text: message,
      senderId: userId,
      timestamp: Date.now()
    });
  };
}